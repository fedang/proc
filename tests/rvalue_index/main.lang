proc make_slice(arr: *[i32, 3]): [i32] {
    return @slice(arr)
}

proc make_arr(x: i32): [i32, 3] {
    return [x, x + 10, x + 20]
}

proc slice_sum(sp: *[i32]): i32 {
    return sp.ptr[0] + sp.ptr[2] + @cast(i32, sp.len)
}

proc main(): i32 {
    var a: [i32, 3] = [4, 5, 6]
    var s: [i32] = @slice(a)
    var i: i32 = 2
    // make_slice(&a)[1] = 5, @slice(a)[0] = 4, make_arr(1)[2] = 21, slice_sum(&s) = 13 -> 43
    return make_slice(&a)[1] + @slice(a)[0] + make_arr(1)[i] + slice_sum(&s)
}
