proc main() : i32 {
    if @size_of(int) != @size_of(*u8) {
        return 1
    }
    if @size_of(uint) != @size_of(*u8) {
        return 2
    }
    if @size_of([u8]) != @size_of(*u8) + @size_of(int) {
        return 3
    }

    var a = [10, 20, 30]
    var s = @slice(a)
    var sum = 0
    var i = 0
    while i < s.len {
        sum += s[i]
        i += 1
    }
    if sum != 60 {
        return 4
    }

    var big: int = 5000000000
    if big != 5000000000 {
        return 5
    }

    return 0
}
