sig A {
    type K = int
    type S

    proc make(x: K): *S
    proc use(x: *S)
}

module B : A {
    type S = int

    proc make(x: K): *S { return @cast(*S, x) }
    proc use(x: *S) { }
}

module C : A {
    type S = bool

    proc make(x: K): *S { return @cast(*S, 0) }
    proc use(x: *S) { }
}

proc main() {
    B.use(C.make(10))
}
