proc cast_to_non_integer() {
    var b1: bool = @cast(bool, 1)
    var b2: bool = @cast(bool, 0)
    var b3: bool = @cast(bool, @size_of(int))

    var v: void
    var p1: *u8 = @cast(*u8, 1)
    var p2: *void = @cast(*void, &v)
}

proc cast_to_integer() {
    var a: u8 = @cast(u8, 1)
    var b: u64 = @cast(u64, 1)
    var c: i32 = @cast(i32, @size_of(int))
}

proc casts() {
    var k = @cast(u32, 4000000000)

    @cast(i64, 0xFFFFFFFFFFFF)

    @cast(i32, 0xFFFFFFFF)

    @cast(u16, 65535)

    @cast(u8, 5000000000)

    @cast(u8, 300)
}

