proc if_chain(x: int) : int {
    if x == 0 {
        return 0
    } else if x == 1 {
        return 1
    } else if x == 2 {
        return 2
    } else {
        return 3
    }
}

proc if_chain_no_final_else(x: int) {
    if x == 0 {
        print32(0)
    } else if x == 1 {
        print32(1)
    }
}

proc if_chain_missing_return(x: int) : int {
    if x == 0 {
        return 0
    } else if x == 1 {
        return 1
    }
    // error: not all branches return
}

proc if_chain_nested(x: int, y: int) : int {
    if x == 0 {
        if y == 0 {
            return 0
        } else if y == 1 {
            return 1
        }
        return 2
    } else if x == 1 {
        return 3
    } else {
        return 4
    }
}

