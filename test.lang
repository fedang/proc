struct zst {
    x: void
}

proc zsp(a: zst, b: void): zst {
    var x: zst = a
    var y = &x
    return x
}

proc zero_test() : @type_of(1) {
    var zero: zst
    var v: void

    puts("sizeof zst is:")
    print32(@cast(int, @size_of(@type_of(zero))))

    zsp(zero, v)
    return 1
}

