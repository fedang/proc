proc main(argc: int, argv: **u8): int {
    var x : int = 10
    x *= 1 + 2
    if x == 10 {
        print32(1)
    } else {
        print32(2)
    }

    structural()
    print32(x / 2)
    return 0
}

proc structural() {
    var s : ABC_s
    s.a = 10
    print32(s.a)
}

type ABC_s = ABC

proc print32(_: int)

struct ABC {
    a: int
    b: bool
    c: u8
}
