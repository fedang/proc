proc main(argc: int, argv: **u8): int {
    var x : int = 10
    x *= 1 + 2
    if x == 10 {
        print32(1)
    } else {
        print32(2)
    }

    puts("sizeof is")
    print32(@cast(int, @size_of(int)))

    var y : int[4]
    y[0] = 99
    print32(y[0])

    var s: int
    var i = 0
    while i < 5 {
        var s = "Hello World"
        puts(s)
        i += 1
    }

    structural()
    print32(x / 2)
    return 0
}

proc structural() {
    var s : ABC_s
    s.a = 10
    print32(s.a)
}

type ABC_s = ABC

proc print32(_: int)

proc puts(_: *u8)

struct ABC {
    a: int
    b: bool
    c: u8
}

